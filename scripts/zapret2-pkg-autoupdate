#!/bin/bash
# Cron root: giữ zapret2 ở bản mới nhất từ repo xbps, khởi động lại service có kiểm tra.
set -Eeuo pipefail
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LOCK_FILE=/run/lock/zapret2-autoupdate.lock
LOG_FILE=/var/log/zapret2-autoupdate.log

exec 9>"$LOCK_FILE"
flock -n 9 || exit 0

log() { printf '[zapret2-autoupdate] %s\n' "$*" | tee -a "$LOG_FILE"; }
installed_ver() { xbps-query -l 2>/dev/null | awk '$2 ~ /^zapret2-/ {print $2; exit}'; }

before="$(installed_ver || true)"
if ! xbps-install -S >/dev/null 2>&1; then
    log 'sync repo thất bại (fingerprint chưa được chấp nhận?)'
    exit 0
fi
if [ -z "$(xbps-query -Rs zapret2 2>/dev/null)" ]; then
    log 'không tìm thấy zapret2 trong repo'
    exit 0
fi
if ! xbps-install -y -u zapret2 >/dev/null 2>&1; then
    log 'xbps-install -u zapret2 thất bại'
    exit 0
fi
after="$(installed_ver || true)"
if [ "$before" = "$after" ]; then
    log "đã ở bản mới nhất (${after:-chưa cài})"
    exit 0
fi
log "đã nâng $before -> $after"

# Preflight trước khi restart (restart làm đứt DNS vài giây).
if ! ip route get 1.1.1.1 >/dev/null 2>&1; then
    log 'không có route mặc định; bỏ qua restart'
    exit 0
fi
if ! sv restart zapret2 >/dev/null 2>&1; then
    log 'sv restart zapret2 thất bại'
    exit 0
fi
sleep 3
log "version: $(/opt/zapret2/nfq2/nfqws2 --version 2>&1 | head -1 || true)"
if nft list table inet zapret2 >/dev/null 2>&1; then
    log 'bảng nft inet zapret2: OK'
else
    log 'CẢNH BÁO: bảng nft inet zapret2 chưa có'
fi
