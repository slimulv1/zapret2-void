#!/bin/sh
# xbps scriptlet: dùng lại binary mới ngay sau khi nâng gói.
# Chỉ restart nếu service đang chạy VÀ mạng đã sẵn sàng, để tránh làm đứt DNS
# trong lúc xbps-install -Syu đang xử lý các gói khác.
PATH=/usr/sbin:/usr/bin:/sbin:/bin

restart_zapret2_if_running() {
    case "$(sv status zapret2 2>/dev/null)" in
        run:*) ;;
        *) return 0 ;;
    esac
    ip route get 1.1.1.1 >/dev/null 2>&1 || return 0
    sv restart zapret2 >/dev/null 2>&1 || return 0
}

apply_network_config() {
    # nftables.conf: chỉ thay khi chưa có bảng void_filter (run script cần bảng này).
    if [ ! -f /etc/nftables.conf ] || ! grep -q 'table inet void_filter' /etc/nftables.conf; then
        [ -f /etc/nftables.conf ] && cp -a /etc/nftables.conf "/etc/nftables.conf.bak.$(date +%Y%m%d%H%M%S)"
        cp /usr/share/examples/zapret2/nftables.conf /etc/nftables.conf
        chmod 0644 /etc/nftables.conf
        if [ -x /etc/sv/nftables/run ] && [ ! -e /var/service/nftables ]; then
            ln -s /etc/sv/nftables /var/service/nftables
        fi
        [ -e /var/service/nftables ] && sv restart nftables >/dev/null 2>&1 || true
    fi
    # dnscrypt-proxy: chỉ đặt config khi binary có và config chưa tồn tại.
    if command -v dnscrypt-proxy >/dev/null 2>&1 && [ ! -f /etc/dnscrypt-proxy.toml ]; then
        cp /usr/share/examples/zapret2/dnscrypt-proxy.toml /etc/dnscrypt-proxy.toml
        chmod 0644 /etc/dnscrypt-proxy.toml
        if [ -x /etc/sv/dnscrypt-proxy/run ] && [ ! -e /var/service/dnscrypt-proxy ]; then
            ln -s /etc/sv/dnscrypt-proxy /var/service/dnscrypt-proxy
        fi
    fi
}

pre_install() {
    # Migration từ installer cũ (/opt/zapret2 không do xbps quản lý).
    # Đời sang backup để tránh xung đột unpack (mdig/, ip2net/, nfqws2...).
    if [ -d /opt/zapret2 ] && [ ! -e /opt/zapret2/.xbps-zapret2 ]; then
        mv /opt/zapret2 "/opt/zapret2.pre-xbps.$(date +%Y%m%d%H%M%S)"
    fi
    if [ -d /etc/sv/zapret2 ] && [ ! -e /etc/sv/zapret2/.xbps-zapret2 ]; then
        mv /etc/sv/zapret2 "/etc/sv/zapret2.pre-xbps.$(date +%Y%m%d%H%M%S)"
    fi
}

post_install() { apply_network_config; restart_zapret2_if_running; }
post_upgrade() { apply_network_config; restart_zapret2_if_running; }

# xbps-src chỉ bọc script này vào INSTALL generic (chạy trigger); chính file
# phải tự dispatch theo $ACTION — nếu không, các hàm trên không bao giờ chạy.
case "${ACTION:-$1}" in
    pre) pre_install ;;
    post)
        if [ "${UPDATE:-$4}" = yes ]; then post_upgrade; else post_install; fi
        ;;
esac
