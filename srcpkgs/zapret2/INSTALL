#!/bin/sh
# xbps scriptlet: dùng lại binary mới ngay sau khi nâng gói.
# Chỉ restart nếu service đang chạy VÀ mạng đã sẵn sàng, để tránh làm đứt DNS
# trong lúc xbps-install -Syu đang xử lý các gói khác.
PATH=/usr/sbin:/usr/bin:/sbin:/bin

restart_zapret2_if_running() {
    case "$(sv status zapret2 2>/dev/null)" in
        run:*) ;;
        *) return 0 ;;
    esac
    ip route get 1.1.1.1 >/dev/null 2>&1 || return 0
    sv restart zapret2 >/dev/null 2>&1 || return 0
}

pre_install() {
    # Migration từ installer cũ (/opt/zapret2 không do xbps quản lý).
    # Đời sang backup để tránh xung đột unpack (mdig/, ip2net/, nfqws2...).
    if [ -d /opt/zapret2 ] && [ ! -e /opt/zapret2/.xbps-zapret2 ]; then
        mv /opt/zapret2 "/opt/zapret2.pre-xbps.$(date +%Y%m%d%H%M%S)"
    fi
}

post_install() { restart_zapret2_if_running; }
post_upgrade() { restart_zapret2_if_running; }
