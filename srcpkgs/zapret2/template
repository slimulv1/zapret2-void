# Template file for 'zapret2'
# Upstream author: bol-van (GitHub login; upstream publishes no public name/email)
# Source: https://github.com/bol-van/zapret2
# Full upstream version tag: v${version} (used in distfiles/changelog)
pkgname=zapret2
version=1.0.8
revision=14
# Không dùng build_style=fetch: nó chỉ copy tarball vào wrksrc mà KHÔNG giải nén.
# Để trống build_style để hook do-extract mặc định rename top-level zapret2-vX thành $wrksrc.
# Upstream ships static x86_64 binaries; no i686 asset exists.
archs="x86_64*"
# Upstream binaries are already stripped static ELFs; xbps-src strip hook fails on them.
nostrip=yes
nodebug=yes
depends="nftables iproute2 python3"
# Tạo user hệ thống do xbps quản lý (fresh install không có installer cũ tạo sẵn).
system_accounts="tpws"
# Khớp user do installer cũ tạo trên máy này, tránh cảnh báo 'unable to modify'.
tpws_homedir="/home/tpws"
tpws_shell="/bin/false"
conf_files="/etc/zapret2/config /etc/nftables.conf /etc/zapret2/dns-candidates /etc/zapret2/dns-autoset.conf /etc/cron.d/zapret2-dns-autoset"
short_desc="Anti-DPI desync tool (nfqws2) by bol-van with nftables NFQUEUE"
maintainer="slimulv1 <slimulv1@users.noreply.github.com>"
license="custom:upstream repository declares no license (no LICENSE file)"
homepage="https://github.com/bol-van/zapret2"
changelog="https://github.com/bol-van/zapret2/releases/tag/v${version}"
distfiles="https://github.com/bol-van/zapret2/releases/download/v${version}/zapret2-v${version}.tar.gz"
checksum=fbd2c39941eea436dce5df4ab51fd19163f31d6b6b49131195400cc552fe77ff

do_install() {
    # Chỉ copy các phần script khởi động cần (common/, init.d/sysv/, lua/,
    # ipset/, binaries/linux-x86_64/); copy '*' sẽ kéo binary lạ làm lỗi shlibs.
    vmkdir opt/zapret2
    vmkdir opt/zapret2/common
    vmkdir opt/zapret2/init.d/sysv
    vmkdir opt/zapret2/lua
    vmkdir opt/zapret2/ipset
    vmkdir opt/zapret2/binaries/linux-x86_64
    vcopy "common/*" opt/zapret2/common/
    vcopy "init.d/sysv/*" opt/zapret2/init.d/sysv/
    vcopy "lua/*" opt/zapret2/lua/
    vcopy "ipset/*" opt/zapret2/ipset/
    vcopy "binaries/linux-x86_64/*" opt/zapret2/binaries/linux-x86_64/
    vmkdir opt/zapret2/nfq2
    ln -s ../binaries/linux-x86_64/nfqws2 "${DESTDIR}/opt/zapret2/nfq2/nfqws2"
    ln -s ../binaries/linux-x86_64/mdig "${DESTDIR}/opt/zapret2/nfq2/mdig"
    ln -s ../binaries/linux-x86_64/ip2net "${DESTDIR}/opt/zapret2/nfq2/ip2net"
    : > "${DESTDIR}/opt/zapret2/.xbps-zapret2"
    vinstall "$FILESDIR/zapret2/config" 644 etc/zapret2 config
    vinstall "$FILESDIR/nftables.conf" 644 etc nftables.conf
    # Bản tham chiếu để user diff khi profile thay đổi giữa các release.
    vsconf "$FILESDIR/zapret2/config" zapret2-config
    vsconf "$FILESDIR/nftables.conf" nftables.conf
    vsconf "$FILESDIR/dnscrypt-proxy.toml" dnscrypt-proxy.toml
    vsconf "$FILESDIR/strategies.json" strategies.json
    # Kiểm tra sức khỏe DNS (giống ghostline), chạy cron 5 phút.
    vmkdir usr/lib/zapret2/dns-autoset
    vinstall "$FILESDIR/dns-autoset.py" 755 usr/lib/zapret2/dns-autoset dns-autoset.py
    vinstall "$FILESDIR/dns-candidates" 644 etc/zapret2 dns-candidates
    vinstall "$FILESDIR/dns-autoset.conf" 644 etc/zapret2 dns-autoset.conf
    vsconf "$FILESDIR/dns-candidates" dns-candidates
    vinstall "$FILESDIR/dns-autoset.cron" 644 etc/cron.d zapret2-dns-autoset
    ln -sf /etc/zapret2/config "${DESTDIR}/opt/zapret2/config"
    # Không dùng vsv(): nó đưa symlink `supervise' vào package, xung đột với
    # thư mục supervise do runit tạo lúc chạy trên hệ thống đã cài installer cũ.
    vmkdir etc/sv/zapret2
    vmkdir etc/sv/zapret2/log
    vinstall "$FILESDIR/zapret2/run" 755 etc/sv/zapret2 run
    vinstall "$FILESDIR/zapret2/finish" 755 etc/sv/zapret2 finish
    vinstall "$FILESDIR/zapret2/log/run" 755 etc/sv/zapret2/log run
    : > "${DESTDIR}/etc/sv/zapret2/.xbps-zapret2"
}
